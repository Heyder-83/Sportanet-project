# Variables de entorno para el proyecto Sportanet

# ===== BACKEND =====

# Puerto del servidor
PORT=3000

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=sportanet_db

# JWT
