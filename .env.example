# Variables de entorno para el proyecto Sportanet

# ===== BACKEND =====

# Puerto del servidor
PORT=3000

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=sportanet_db

# TLS hacia MySQL: false en local/Docker; true en Azure Database for MySQL (ver docs/AZURE_MYSQL_TLS.md).
# Con true la validación del certificado siempre queda activa. DB_SSL_CA = ruta al PEM de la CA raíz (opcional).
DB_SSL=false
DB_SSL_CA=

# JWT
JWT_SECRET=tu-clave-secreta-super-larga-y-segura-aqui-min-32-caracteres
JWT_EXPIRE=24h

# CORS
CORS_ORIGIN=http://localhost:8000

# Node
NODE_ENV=development

# ===== FRONTEND =====

# URL del API backend
VITE_API_URL=http://localhost:3000

# Ambiente
VITE_ENV=development
