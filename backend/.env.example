# Example environment variables for the backend
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=sportanet_v1

# Server port (Render asigna dinámicamente en producción; 5000 en local)
PORT=5000

# Secreto para firmar JWT (OBLIGATORIO, sin valor por defecto). Usa >= 32 caracteres aleatorios.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
