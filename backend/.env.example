# Example environment variables for the backend
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=sportanet_v1

# Server port (Render asigna dinámicamente en producción; 5000 en local)
PORT=5000

# Secreto para firmar JWT (OBLIGATORIO, sin valor por defecto). Usa >= 32 caracteres aleatorios.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- SPN_AD (base aparte de administradores; opcional: sin DB_AD_NAME las rutas /api/admin no se montan) ---
# Si defines DB_AD_NAME, las demás son OBLIGATORIAS y la app falla al arrancar si faltan.
# Ver "Base de Datos/spn_ad/README.md" (usuario de MySQL aislado y lista de TSU).
DB_AD_NAME=
DB_AD_USER=
DB_AD_PASSWORD=
# Clave del HMAC con el que se hashean los TSU. >= 32 caracteres aleatorios y distinta de JWT_SECRET.
# Si se cambia, los hash de TSU ya guardados dejan de coincidir.
TSU_HMAC_KEY=
# Secreto para firmar los JWT de los administradores (SPNdev.2). >= 32 caracteres aleatorios y DISTINTO de JWT_SECRET
# y de TSU_HMAC_KEY. Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=
