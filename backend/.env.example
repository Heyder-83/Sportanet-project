# Variables de entorno para el backend
# Nota: para Docker, la base de datos se expone como servicio 'db'.
DB_HOST=db
DB_PORT=3306
DB_USER=sportanet
DB_PASSWORD=sportanet
DB_NAME=sportanet_v1

# TLS hacia MySQL (aplica a la base principal, a SPN_AD y a scripts/migrate.js).
# Local / Docker: false (valor por defecto si se omite).
# Azure Database for MySQL Flexible Server: true + DB_SSL_CA (ver docs/AZURE_MYSQL_TLS.md).
# Con true la validación del certificado siempre queda activa (rejectUnauthorized: true).
DB_SSL=false
# Ruta al archivo PEM con la CA raíz (bundle). Relativa a backend/ o absoluta. Solo se usa si DB_SSL=true.
# Ejemplo Azure App Service: DB_SSL_CA=certs/azure-mysql-ca-bundle.pem
DB_SSL_CA=

PORT=5000

# Secreto para firmar JWT (obligatorio; mínimo 32 caracteres aleatorios)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_random_string_of_at_least_32_characters

# Variables opcionales para SPN_AD / administradores
DB_AD_NAME=
DB_AD_USER=
DB_AD_PASSWORD=
TSU_HMAC_KEY=
ADMIN_JWT_SECRET=
